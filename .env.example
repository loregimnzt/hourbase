# Hourbase environment variables.
# Copy to .env.local and fill in. Leave BOTH empty to run in local demo mode.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (or the legacy "anon" key). Safe for the browser —
# access is enforced by Row Level Security. NEXT_PUBLIC_SUPABASE_ANON_KEY is
# also accepted for older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER add the service_role / secret key here or to any NEXT_PUBLIC_ variable.
# Hourbase does not need it.
